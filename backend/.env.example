# Copy this file to .env. NO key is required: Wikipedia, DuckDuckGo, arXiv, OpenAlex
# and Crossref are searched automatically. A Brave/Google key only adds coverage.
OPENALEX_EMAIL=
# For public website discovery, choose brave or google and add valid credentials.
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional API protection. If set, provide this value in About -> API settings.
API_KEY=

# Set once to bootstrap the initial admin account on first database use.
# Username: superadmin | Email: admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=

# Session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=0

# Contact form email delivery (SMTP). Requests are sent to CONTACT_ADMIN_EMAIL.
CONTACT_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Lightweight default: TF-IDF only. For paraphrase/semantic matching:
# install requirements-embeddings.txt and set USE_EMBEDDINGS=1
USE_EMBEDDINGS=0
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Similarity threshold (0.50 = 50% sentence match). Tune with a labelled validation set.
MATCH_THRESHOLD=0.50
MAX_QUERIES=6
RESULTS_PER_QUERY=4
MAX_SOURCES=30
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=60000
PORT=5000
HOST=127.0.0.1
DB_PATH=data/plagiascan.db
ALLOWED_ORIGIN=*
